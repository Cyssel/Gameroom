<controls:WindowBase x:Class="Playnite.DesktopApp.Windows.GameAchievementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Playnite.Controls;assembly=Playnite"
        mc:Ignorable="d"
        Style="{DynamicResource StandardWindowStyle}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="{Binding Title}" Height="760" Width="860" MinHeight="400" MinWidth="560"
        ShowMinimizeButton="False">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NormalBorderBrush}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="{DynamicResource LOCGameroomAchievementsRefresh}" Margin="10,0,0,0"
                        Style="{StaticResource BottomButton}" Command="{Binding RefreshCommand}" />
                <Button DockPanel.Dock="Right" Content="{DynamicResource LOCCloseLabel}" IsCancel="True" IsDefault="True"
                        Style="{StaticResource BottomButton}" Command="{Binding CloseCommand}" />
            </DockPanel>
        </Border>

        <!-- Summary -->
        <StackPanel DockPanel.Dock="Top" Margin="24,20,24,8"
                    Visibility="{Binding HasAchievements, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontSize="30" FontWeight="SemiBold"
                           Style="{StaticResource GameroomText}" Foreground="{StaticResource GameroomAccentTextBrush}" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="{Binding GameName}" Style="{StaticResource GameroomText}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource GameroomText}" FontSize="14" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding SourcesText}" Style="{StaticResource GameroomMutedText}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
            <ProgressBar Style="{StaticResource GameroomProgressBar}" Value="{Binding Percent, Mode=OneWay}" Margin="0,14,0,0" />
            <DockPanel Margin="0,16,0,0">
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource GameroomToggle}" IsChecked="{Binding RevealHidden}" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource LOCGameroomAchievementsRevealHidden}" Style="{StaticResource GameroomText}" />
                </CheckBox>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource GameroomTab}" Content="{DynamicResource LOCGameroomAchievementsFilterAll}" IsChecked="{Binding ShowAll}" />
                    <RadioButton Style="{StaticResource GameroomTab}" Content="{DynamicResource LOCGameroomAchievementsFilterUnlocked}" IsChecked="{Binding ShowUnlocked}" />
                    <RadioButton Style="{StaticResource GameroomTab}" Content="{DynamicResource LOCGameroomAchievementsFilterLocked}" IsChecked="{Binding ShowLocked}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Grid>
            <TextBlock Text="{DynamicResource LOCGameroomAchievementsLoading}" Style="{StaticResource GameroomMutedText}" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- No achievements or game not found on Steam -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="&#xE734;" FontFamily="{StaticResource GameroomIconFont}" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{StaticResource GameroomAccentTextBrush}" />
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource GameroomText}" FontSize="15" TextWrapping="Wrap" TextTrimming="None"
                           TextAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Text="{DynamicResource LOCGameroomAchievementsAppIdHint}" Style="{StaticResource GameroomMutedText}"
                           TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" Margin="0,16,0,8" />
                <DockPanel HorizontalAlignment="Center">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GameroomPrimaryButton}" Margin="10,0,0,0"
                            Content="{DynamicResource LOCGameroomAchievementsUseAppId}" Command="{Binding UseAppIdCommand}" />
                    <Border Style="{StaticResource GameroomInputBorder}" Width="160">
                        <TextBox Style="{StaticResource GameroomInputText}" Text="{Binding SteamAppId, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                </DockPanel>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Margin="24,8,10,12"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                          Visibility="{Binding HasAchievements, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Style="{StaticResource GameroomCard}" Padding="12" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="150">
                                    <TextBlock Text="{Binding UnlockText}" Style="{StaticResource GameroomText}" Foreground="{StaticResource GameroomSuccessBrush}"
                                               HorizontalAlignment="Right" FontSize="12.5"
                                               Visibility="{Binding Unlocked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                        <Border CornerRadius="4" Padding="6,1" Margin="0,0,6,0" Background="{StaticResource GameroomAccentBrush}"
                                                Visibility="{Binding IsRare, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{DynamicResource LOCGameroomAchievementsRare}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{Binding RarityText}" Style="{StaticResource GameroomMutedText}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <ContentControl x:Name="Icon" Width="64" Height="64" Content="{Binding}" Focusable="False"
                                                ContentTemplate="{StaticResource GameroomAchievementIcon}" VerticalAlignment="Top" />

                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="NameText" Text="{Binding Name}" Style="{StaticResource GameroomText}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DescriptionText" Text="{Binding Description}" Style="{StaticResource GameroomMutedText}"
                                               TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0" />
                                    <DockPanel Margin="0,8,0,0" Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource GameroomMutedText}" FontSize="12" Margin="10,0,0,0" />
                                        <ProgressBar Style="{StaticResource GameroomProgressBar}" Height="6" Value="{Binding ProgressPercent, Mode=OneWay}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Unlocked}" Value="False">
                                <Setter TargetName="Icon" Property="Opacity" Value="0.6" />
                                <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource GameroomMutedTextBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSecret}" Value="True">
                                <Setter TargetName="DescriptionText" Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DockPanel>
</controls:WindowBase>
