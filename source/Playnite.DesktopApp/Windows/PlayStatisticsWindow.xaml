<controls:WindowBase x:Class="Playnite.DesktopApp.Windows.PlayStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Playnite.Controls;assembly=Playnite"
        xmlns:pcon="clr-namespace:Playnite.Converters;assembly=Playnite"
        xmlns:gr="clr-namespace:Playnite.Gameroom;assembly=Playnite"
        xmlns:pdvm="clr-namespace:Playnite.DesktopApp.ViewModels"
        mc:Ignorable="d"
        Style="{DynamicResource StandardWindowStyle}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="{DynamicResource LOCGameroomPlayStatsTitle}" Height="780" Width="960" MinHeight="450" MinWidth="700"
        ShowMinimizeButton="False">

    <controls:WindowBase.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
        <pcon:EnumToBooleanConverter x:Key="PeriodToBooleanConverter" />

        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="TileValue" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="TileCaption" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="AxisText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>

        <ItemsPanelTemplate x:Key="SingleRowPanel">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="SingleColumnPanel">
            <UniformGrid Columns="1" />
        </ItemsPanelTemplate>
    </controls:WindowBase.Resources>

    <DockPanel Margin="5">
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NormalBorderBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{DynamicResource LOCCloseLabel}" IsCancel="True" IsDefault="True"
                        Style="{StaticResource BottomButton}" Command="{Binding CloseCommand}" />
                <TextBlock Margin="10,0,10,0" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap"
                           Text="{DynamicResource LOCGameroomPlayStatsNote}" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10">
                <DockPanel Margin="0,0,0,15">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RangeText}" VerticalAlignment="Center" Opacity="0.7" />
                    <WrapPanel>
                        <RadioButton GroupName="PlayStatsPeriod" Margin="0,0,25,0" VerticalAlignment="Center"
                                     Content="{DynamicResource LOCGameroomPlayStatsLast7Days}"
                                     IsChecked="{Binding Period, Converter={StaticResource PeriodToBooleanConverter}, ConverterParameter={x:Static gr:PlayStatisticsPeriod.Last7Days}}" />
                        <RadioButton GroupName="PlayStatsPeriod" Margin="0,0,25,0" VerticalAlignment="Center"
                                     Content="{DynamicResource LOCGameroomPlayStatsLast30Days}"
                                     IsChecked="{Binding Period, Converter={StaticResource PeriodToBooleanConverter}, ConverterParameter={x:Static gr:PlayStatisticsPeriod.Last30Days}}" />
                        <RadioButton GroupName="PlayStatsPeriod" Margin="0,0,25,0" VerticalAlignment="Center"
                                     Content="{DynamicResource LOCGameroomPlayStatsThisYear}"
                                     IsChecked="{Binding Period, Converter={StaticResource PeriodToBooleanConverter}, ConverterParameter={x:Static gr:PlayStatisticsPeriod.ThisYear}}" />
                        <RadioButton GroupName="PlayStatsPeriod" Margin="0,0,25,0" VerticalAlignment="Center"
                                     Content="{DynamicResource LOCGameroomPlayStatsAll}"
                                     IsChecked="{Binding Period, Converter={StaticResource PeriodToBooleanConverter}, ConverterParameter={x:Static gr:PlayStatisticsPeriod.All}}" />
                    </WrapPanel>
                </DockPanel>

                <UniformGrid Rows="1" Margin="0,0,-10,15">
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding TotalText}" />
                            <TextBlock Style="{StaticResource TileCaption}" Text="{DynamicResource LOCGameroomPlayStatsTotal}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding SessionsText}" />
                            <TextBlock Style="{StaticResource TileCaption}" Text="{DynamicResource LOCGameroomPlayStatsSessions}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding AverageSessionText}" />
                            <TextBlock Style="{StaticResource TileCaption}" Text="{DynamicResource LOCGameroomPlayStatsAverageSession}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding DaysPlayedText}" />
                            <TextBlock Style="{StaticResource TileCaption}" Text="{DynamicResource LOCGameroomPlayStatsDaysPlayed}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding GamesText}" />
                            <TextBlock Style="{StaticResource TileCaption}" Text="{DynamicResource LOCGameroomPlayStatsGames}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <GroupBox Header="{Binding ChartTitle}">
                    <Grid Margin="10,15,15,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Y axis, labels are centered on their grid line -->
                        <ItemsControl Grid.Column="0" Grid.Row="0" ItemsSource="{Binding AxisLabels}"
                                      ItemsPanel="{StaticResource SingleColumnPanel}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource AxisText}" Text="{Binding}"
                                               VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-8,8,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Column="0" Grid.Row="0" Style="{StaticResource AxisText}" Text="0"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,8,-8" />

                        <ItemsControl Grid.Column="1" Grid.Row="0" ItemsSource="{Binding AxisLabels}"
                                      ItemsPanel="{StaticResource SingleColumnPanel}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NormalBorderBrush}" Opacity="0.5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Grid.Column="1" Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource NormalBorderBrush}" />

                        <ItemsControl Grid.Column="1" Grid.Row="0" ItemsSource="{Binding Bars}"
                                      Height="{x:Static pdvm:PlayStatisticsViewModel.ChartHeight}"
                                      ItemsPanel="{StaticResource SingleRowPanel}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" ToolTip="{Binding ToolTip}">
                                        <Rectangle VerticalAlignment="Bottom" Height="{Binding Height}" MaxWidth="48" Margin="1.5,0"
                                                   Fill="{DynamicResource GlyphBrush}" RadiusX="2" RadiusY="2" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl Grid.Column="1" Grid.Row="1" ItemsSource="{Binding Bars}" Margin="0,5,0,0"
                                      ItemsPanel="{StaticResource SingleRowPanel}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Negative margins let labels be wider than their bar -->
                                    <TextBlock Style="{StaticResource AxisText}" Text="{Binding Label}"
                                               HorizontalAlignment="Center" TextAlignment="Center" Margin="-40,0,-40,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{DynamicResource LOCGameroomPlayStatsEmpty}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"
                                   Visibility="{Binding HasData, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="{DynamicResource LOCGameroomPlayStatsTopGames}" Margin="0,15,0,0"
                          Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding TopGames}" Margin="10" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="55" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Implicit TextBlock style doesn't apply inside templates -->
                                    <TextBlock Grid.Column="0" Text="{Binding Rank}" Opacity="0.7" VerticalAlignment="Center"
                                               Style="{StaticResource BaseTextBlockStyle}" />
                                    <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Style="{StaticResource BaseTextBlockStyle}" ToolTip="{Binding SessionsText}">
                                        <Hyperlink Command="{Binding SelectCommand}">
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                    <Grid Grid.Column="2" Height="10" Margin="15,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding BarWidth}" />
                                            <ColumnDefinition Width="{Binding RestWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Fill="{DynamicResource GlyphBrush}" RadiusX="2" RadiusY="2" />
                                    </Grid>
                                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" TextAlignment="Right" VerticalAlignment="Center"
                                               Style="{StaticResource BaseTextBlockStyle}" />
                                    <TextBlock Grid.Column="4" Text="{Binding PercentageText}" TextAlignment="Right" VerticalAlignment="Center" Opacity="0.7"
                                               Style="{StaticResource BaseTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</controls:WindowBase>
