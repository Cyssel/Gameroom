<UserControl x:Class="Playnite.DesktopApp.Controls.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1300"
             Background="{DynamicResource WindowBackgourndBrush}">

    <UserControl.Resources>
        <Style x:Key="AccountStatusText" TargetType="TextBlock" BasedOn="{StaticResource GameroomText}">
            <Setter Property="Text" Value="{Binding StatusMessage}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="0,14,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource GameroomSuccessBrush}" />
            <Setter Property="Visibility" Value="{Binding StatusMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource GameroomErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="36,26,36,36">

            <!-- No server yet: accounts live on the user's own Supabase project -->
            <Border Style="{StaticResource GameroomCard}" Width="520" Padding="36,32" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,30,0,0" Visibility="{Binding ShowServerSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource GameroomAccentBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE753;" FontFamily="{StaticResource GameroomIconFont}" FontSize="28" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource LOCGameroomCloudServerTitle}" Style="{StaticResource GameroomText}" FontSize="26" FontWeight="SemiBold" Margin="0,18,0,0" />
                    <TextBlock Text="{DynamicResource LOCGameroomCloudServerText}" Style="{StaticResource GameroomMutedText}" FontSize="14"
                               TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,22" />

                    <TextBlock Text="{DynamicResource LOCGameroomCloudServerUrl}" Style="{StaticResource GameroomMutedText}" Margin="0,0,0,6" />
                    <Border Style="{StaticResource GameroomInputBorder}" Margin="0,0,0,14">
                        <TextBox Style="{StaticResource GameroomInputText}" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <TextBlock Text="{DynamicResource LOCGameroomCloudServerKey}" Style="{StaticResource GameroomMutedText}" Margin="0,0,0,6" />
                    <Border Style="{StaticResource GameroomInputBorder}">
                        <TextBox Style="{StaticResource GameroomInputText}" Text="{Binding ServerKey, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <TextBlock Style="{StaticResource AccountStatusText}" />

                    <DockPanel Margin="0,22,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GameroomSecondaryButton}" Margin="12,0,0,0"
                                Content="{DynamicResource LOCCancelLabel}" Command="{Binding CancelServerCommand}"
                                Visibility="{Binding IsServerConfigured, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Style="{StaticResource GameroomPrimaryButton}" HorizontalAlignment="Stretch" IsDefault="True"
                                Content="{DynamicResource LOCGameroomCloudServerConnect}" Command="{Binding ConnectServerCommand}" />
                    </DockPanel>

                    <TextBlock Text="{DynamicResource LOCGameroomCloudServerHint}" Style="{StaticResource GameroomMutedText}" FontSize="12"
                               TextWrapping="Wrap" TextTrimming="None" Margin="0,18,0,0" />
                    <Button Style="{StaticResource GameroomLinkButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Content="{DynamicResource LOCGameroomCloudServerGuide}" Command="{Binding OpenServerGuideCommand}" />
                </StackPanel>
            </Border>

            <!-- Signed out: sign in / create account -->
            <Border Style="{StaticResource GameroomCard}" Width="460" Padding="36,32" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,30,0,0" Visibility="{Binding ShowSignIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource GameroomAccentBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE753;" FontFamily="{StaticResource GameroomIconFont}" FontSize="28" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource LOCGameroomAccountTitle}" Style="{StaticResource GameroomText}" FontSize="26" FontWeight="SemiBold" Margin="0,18,0,0" />
                    <TextBlock Text="{DynamicResource LOCGameroomAccountSubtitle}" Style="{StaticResource GameroomMutedText}" FontSize="14"
                               TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,22" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <RadioButton Style="{StaticResource GameroomTab}" Content="{DynamicResource LOCGameroomAccountSignIn}" IsChecked="{Binding IsSignInMode}" />
                        <RadioButton Style="{StaticResource GameroomTab}" Content="{DynamicResource LOCGameroomAccountSignUp}" IsChecked="{Binding IsSignUpMode}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsSignUpMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource LOCGameroomAccountUsername}" Style="{StaticResource GameroomMutedText}" Margin="0,0,0,6" />
                        <Border Style="{StaticResource GameroomInputBorder}" Margin="0,0,0,14">
                            <TextBox Style="{StaticResource GameroomInputText}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource LOCGameroomAccountEmail}" Style="{StaticResource GameroomMutedText}" Margin="0,0,0,6" />
                    <Border Style="{StaticResource GameroomInputBorder}" Margin="0,0,0,14">
                        <TextBox Style="{StaticResource GameroomInputText}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <TextBlock Text="{DynamicResource LOCGameroomAccountPassword}" Style="{StaticResource GameroomMutedText}" Margin="0,0,0,6" />
                    <Border Style="{StaticResource GameroomInputBorder}">
                        <PasswordBox x:Name="PasswordInput" Style="{StaticResource GameroomInputPassword}" KeyDown="PasswordInput_KeyDown" />
                    </Border>

                    <TextBlock Style="{StaticResource AccountStatusText}" />

                    <Grid Margin="0,22,0,0">
                        <Button Style="{StaticResource GameroomPrimaryButton}" HorizontalAlignment="Stretch"
                                Content="{DynamicResource LOCGameroomAccountSignIn}" IsDefault="True"
                                Command="{Binding SignInCommand}" CommandParameter="{Binding ElementName=PasswordInput}"
                                Visibility="{Binding IsSignInMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Style="{StaticResource GameroomPrimaryButton}" HorizontalAlignment="Stretch"
                                Content="{DynamicResource LOCGameroomAccountCreate}"
                                Command="{Binding SignUpCommand}" CommandParameter="{Binding ElementName=PasswordInput}"
                                Visibility="{Binding IsSignUpMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>

                    <TextBlock Text="{DynamicResource LOCGameroomAccountPrivacy}" Style="{StaticResource GameroomMutedText}" FontSize="12"
                               TextWrapping="Wrap" TextTrimming="None" Margin="0,18,0,0" />

                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GameroomLinkButton}" VerticalAlignment="Center"
                                Content="{DynamicResource LOCGameroomCloudServerChange}" Command="{Binding ChangeServerCommand}" />
                        <TextBlock Style="{StaticResource GameroomMutedText}" FontSize="12" VerticalAlignment="Center" Text="{Binding ServerName}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Signed in: profile and cloud saves -->
            <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BooleanToVisibilityConverter}}" MaxWidth="1100" HorizontalAlignment="Stretch">
                <Border Style="{StaticResource GameroomCard}" Padding="28,24">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GameroomSecondaryButton}" VerticalAlignment="Center"
                                Content="{DynamicResource LOCGameroomAccountSignOut}" Command="{Binding SignOutCommand}" />
                        <Border Width="84" Height="84" CornerRadius="42" Background="{StaticResource GameroomAccentBrush}">
                            <TextBlock Text="{Binding ProfileInitial}" Style="{StaticResource GameroomText}" FontSize="36" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProfileName}" Style="{StaticResource GameroomText}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ProfileEmail}" Style="{StaticResource GameroomMutedText}" FontSize="14" />
                            <TextBlock Text="{Binding MemberSince}" Style="{StaticResource GameroomMutedText}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <UniformGrid Columns="3" Margin="0,16,-14,0">
                    <Border Style="{StaticResource GameroomCard}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LOCGameroomHomeTotalPlaytime}" Style="{StaticResource GameroomMutedText}" />
                            <TextBlock Text="{Binding TotalPlaytime}" Style="{StaticResource GameroomText}" FontSize="26" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GameroomCard}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LOCGameroomAccountPlayedGames}" Style="{StaticResource GameroomMutedText}" />
                            <TextBlock Text="{Binding PlayedGames}" Style="{StaticResource GameroomText}" FontSize="26" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GameroomCard}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LOCGameroomHomeCloud}" Style="{StaticResource GameroomMutedText}" />
                            <TextBlock Text="{Binding CloudSummary}" Style="{StaticResource GameroomText}" FontSize="15" FontWeight="SemiBold"
                                       TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource GameroomCard}" Margin="0,16,0,0" Padding="24,20">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GameroomPrimaryButton}" Command="{Binding SyncCommand}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;" FontFamily="{StaticResource GameroomIconFont}" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource LOCGameroomAccountSyncNow}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCGameroomAccountCloudSaves}" Style="{StaticResource GameroomText}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SyncStatus}" Style="{StaticResource GameroomMutedText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <CheckBox Style="{StaticResource GameroomToggle}" Margin="0,18,0,0" IsChecked="{Binding CloudSavesEnabled}">
                            <TextBlock Text="{DynamicResource LOCGameroomAccountAutoUpload}" Style="{StaticResource GameroomText}" />
                        </CheckBox>

                        <TextBlock Text="{DynamicResource LOCGameroomAccountNoCloudSaves}" Style="{StaticResource GameroomMutedText}" Margin="0,20,0,0"
                                   TextWrapping="Wrap" TextTrimming="None"
                                   Visibility="{Binding HasCloudGames, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" />

                        <ItemsControl ItemsSource="{Binding CloudGames}" Margin="0,18,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource GameroomCardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LastBackup}" Style="{StaticResource GameroomMutedText}" VerticalAlignment="Center" />
                                            <Border Width="36" Height="36" CornerRadius="10" Background="#269B8CFF">
                                                <TextBlock Text="&#xE753;" FontFamily="{StaticResource GameroomIconFont}" Foreground="{StaticResource GameroomAccentTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GameName}" Style="{StaticResource GameroomText}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource GameroomMutedText}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
