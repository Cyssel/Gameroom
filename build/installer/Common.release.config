<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces source/Playnite/Common.config (development values) in installed builds. Used by build/publish.ps1. -->
<appSettings>
  <add key="UpdateUrl" value="" />
  <add key="UpdateUrl2" value="" />
  <!-- Playnite's add-on database, so extensions and themes can be browsed and updated. -->
  <add key="ServicesUrl" value="https://api.playnite.link/api" />
  <add key="DocsRootUrl" value="https://api.playnite.link/docs" />
  <add key="UpdateBranch" value="stable" />
  <add key="ThrowAllErrors" value="False" />
  <add key="OfflineMode" value="False" />
  <add key="PipeEndpoint" value="net.pipe://localhost/GameroomPipe" />
  <add key="AppBranch" value="stable" />
  <add key="wcf:useBestMatchNamedPipeUri" value="true" />
</appSettings>
